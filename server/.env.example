GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com
GEMINI_MODEL=gemini-3.6-flash
PORT=4000
# Optional: restrict API access to one origin (e.g. https://jeevitham.vercel.app).
# Leave unset for local dev, where any origin is allowed.
CORS_ORIGIN=
# Signs login sessions (JWTs). Required in production — without it, a random
# secret is generated per process and every login is invalidated on restart.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
